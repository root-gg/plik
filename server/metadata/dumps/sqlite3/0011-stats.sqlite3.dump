CREATE TABLE `settings` (`key` text,`value` text,PRIMARY KEY (`key`));
INSERT INTO settings VALUES('key1','val1');
CREATE TABLE `cli_auth_sessions` (`code` text,`secret` text,`status` text DEFAULT "pending",`token` text,`created_at` datetime,`expires_at` datetime,PRIMARY KEY (`code`));
CREATE TABLE `usage_stats` (`user_id` text NOT NULL DEFAULT "",`token` text NOT NULL DEFAULT "",`current_uploads` integer,`current_files` integer,`current_size` integer,`lifetime_uploads` integer,`lifetime_files` integer,`lifetime_size` integer,`downloads` integer,`downloaded_bytes` integer,`uploaded_bytes` integer,`lifetime_users` integer,`current_password_uploads` integer,`lifetime_password_uploads` integer,`current_removable_uploads` integer,`lifetime_removable_uploads` integer,`current_one_shot_uploads` integer,`lifetime_one_shot_uploads` integer,`current_stream_uploads` integer,`lifetime_stream_uploads` integer,`current_extend_ttl_uploads` integer,`lifetime_extend_ttl_uploads` integer,`current_e2ee_uploads` integer,`lifetime_e2ee_uploads` integer,`current_comment_uploads` integer,`lifetime_comment_uploads` integer,`current_ttl_none_uploads` integer,`lifetime_ttl_none_uploads` integer,`current_ttl_lt1h_uploads` integer,`lifetime_ttl_lt1h_uploads` integer,`current_ttl_1h1d_uploads` integer,`lifetime_ttl_1h1d_uploads` integer,`current_ttl_1d7d_uploads` integer,`lifetime_ttl_1d7d_uploads` integer,`current_ttl_7d30d_uploads` integer,`lifetime_ttl_7d30d_uploads` integer,`current_ttl_gt30d_uploads` integer,`lifetime_ttl_gt30d_uploads` integer,`current_file_size_lt1m_files` integer,`lifetime_file_size_lt1m_files` integer,`current_file_size_1m10m_files` integer,`lifetime_file_size_1m10m_files` integer,`current_file_size_10m100m_files` integer,`lifetime_file_size_10m100m_files` integer,`current_file_size_100m1g_files` integer,`lifetime_file_size_100m1g_files` integer,`current_file_size_1g10g_files` integer,`lifetime_file_size_1g10g_files` integer,`current_file_size_10g100g_files` integer,`lifetime_file_size_10g100g_files` integer,`current_file_size_gt100g_files` integer,`lifetime_file_size_gt100g_files` integer,`last_upload_at` datetime,`started_at` datetime,`created_at` datetime,`updated_at` datetime,PRIMARY KEY (`user_id`,`token`));
