CREATE TABLE `download_stats_daily` (`day` datetime,`entity_type` text,`entity_id` text,`downloads` integer,`bytes` integer,`user_id` text,`token` text,`updated_at` datetime,PRIMARY KEY (`day`,`entity_type`,`entity_id`));
CREATE TABLE `upload_stats_daily` (`day` datetime,`user_id` text,`token` text,`uploads` integer,`bytes` integer,`updated_at` datetime,PRIMARY KEY (`day`,`user_id`,`token`));
