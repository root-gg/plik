CREATE TABLE `uploads` (`id` text,`ttl` integer,`extend_ttl` numeric,`remote_ip` text,`comments` text,`e2ee` text,`upload_token` text,`user` text,`token` text,`stream` numeric,`one_shot` numeric,`removable` numeric,`protected_by_password` numeric,`login` text,`password` text,`download_count` integer,`last_downloaded_at` datetime,`downloaded_bytes` integer,`created_at` datetime,`deleted_at` datetime,`expire_at` datetime,PRIMARY KEY (`id`));
