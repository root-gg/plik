CREATE TABLE `users` (`id` text,`provider` text,`login` text,`password` text,`name` text,`email` text,`profile_picture` text,`theme` text,`language` text,`is_admin` numeric,`max_file_size` integer,`max_user_size` integer,`max_ttl` integer,`created_at` datetime,PRIMARY KEY (`id`));
