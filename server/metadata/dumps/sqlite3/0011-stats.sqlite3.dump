CREATE TABLE `tokens` (`token` text,`comment` text,`user_id` text,`created_at` datetime,PRIMARY KEY (`token`),CONSTRAINT `fk_users_tokens` FOREIGN KEY (`user_id`) REFERENCES `users`(`id`));
