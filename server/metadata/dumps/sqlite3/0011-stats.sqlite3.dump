CREATE INDEX `idx_upload_expire_at` ON `uploads`(`expire_at`);
CREATE INDEX `idx_upload_deleted_at` ON `uploads`(`deleted_at`);
CREATE INDEX `idx_upload_downloaded_bytes` ON `uploads`(`downloaded_bytes`);
CREATE INDEX `idx_upload_download_count` ON `uploads`(`download_count`);
CREATE INDEX `idx_upload_user_token` ON `uploads`(`token`);
CREATE INDEX `idx_upload_user` ON `uploads`(`user`);
CREATE INDEX `idx_file_upload_id` ON `files`(`upload_id`);
CREATE INDEX `idx_cli_auth_sessions_expires_at` ON `cli_auth_sessions`(`expires_at`);
CREATE INDEX `idx_usage_stats_token` ON `usage_stats`(`token`);
CREATE INDEX `idx_download_stats_daily_user_day` ON `download_stats_daily`(`user_id`,`day`);
CREATE INDEX `idx_upload_stats_daily_user_day` ON `upload_stats_daily`(`user_id`,`day`);
COMMIT;
